# Used by docker-compose.yml for all services.
# Keep this file free of real production credentials; copy it to .env first.

# MariaDB service
MARIADB__ROOT_PASSWORD=example-root-password
MARIADB__DATABASE=pappaetstats
MARIADB__USER=pappa
MARIADB__PASSWORD=example-password
MARIADB__HOST_PORT=3307

# PappaETStats app service
PAPPAETSTATS__INGEST__TOKEN=dev-token-change-me
PAPPAETSTATS__WEBHOOK__URL=http://pappagather:8080/webhook/game-completed
PAPPAETSTATS__WEBHOOK__TOKEN=dev-webhook-token-change-me
PAPPAETSTATS__WEBHOOK__FRONTEND_BASE_URL=http://localhost:5080
PAPPAETSTATS__DISCORD__CLIENT_ID=
PAPPAETSTATS__DISCORD__CLIENT_SECRET=

# PappaGather service
PAPPAGATHER__DISCORD_TOKEN=replace-with-discord-token
PAPPAGATHER__GATHER_TEAM_SIZE=6
PAPPAGATHER__WEBHOOK_CHANNEL_ID=replace-with-channel-id
PAPPAGATHER__GATHER_CHANNEL_ID=replace-with-channel-id
PAPPAGATHER__ADMIN_ROLE_ID=replace-with-role-id
PAPPAGATHER__WEBHOOK_MOVE_AXIS_CHANNEL_ID=replace-with-channel-id
PAPPAGATHER__WEBHOOK_MOVE_ALLIES_CHANNEL_ID=replace-with-channel-id
PAPPAGATHER__WEBHOOK_MOVE_PATH=/webhook/move-teams
PAPPAGATHER__GATHER_POLL_ROLE_ID=

# The app connection string is built by docker-compose with Server=mariadb.
# Demo files are stored in the app_data volume at /app/App_Data/demos.
