# Used by docker-compose.yml for local MariaDB
MARIADB_ROOT_PASSWORD=example-root-password
MARIADB_DATABASE=pappaetstats
MARIADB_USER=pappa
MARIADB_PASSWORD=example-password

# Optional: used by the .NET server
# These map to appsettings.json keys under the "Pappa" section.
Pappa__Ingest__Token=dev-token-change-me
Pappa__Db__Provider=mariadb
Pappa__Db__ConnectionString=Server=127.0.0.1;Port=3306;Database=pappaetstats;User=pappa;Password=example-password;
