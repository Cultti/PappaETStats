@page "/matches/{Id:guid}"
@using Microsoft.EntityFrameworkCore
@using PappaETStats.Server.Data
@using PappaETStats.Server.Domain
@using PappaETStats.Server.Components.Shared
@inject IDbContextFactory<StatsDbContext> DbFactory

<PageTitle>Match</PageTitle>

@if (_match is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h4">@_match.MapName <MudText Typo="Typo.subtitle1" Inline="true">(@_match.ExternalMatchId)</MudText></MudText>

        <MudStack Spacing="1" Class="mt-2">
            <MudText Typo="Typo.body1"><strong>Server:</strong> <EtColoredText Text="@_match.ServerName" /></MudText>
            <MudText Typo="Typo.body2"><strong>Time:</strong> @(_round1?.NextTimeLimit ?? "-") / @(_round2?.NextTimeLimit ?? "-")</MudText>
            <MudText Typo="Typo.body2"><strong>Result:</strong> @MatchResultText(_match)</MudText>
        </MudStack>
    </MudPaper>

    <MudTabs Class="mt-6" Rounded="true" ApplyEffectsToContainer="true" Elevation="1">
        <MudTabPanel Text="Overall">
            @if (_round2 is null)
            {
                <MudText Typo="Typo.body2">No round 2 ingested yet.</MudText>
            }
            else
            {
                @OverallContent(_match, _round2)
            }
        </MudTabPanel>

        <MudTabPanel Text="Round 1">
            @if (_round1 is null)
            {
                <MudText Typo="Typo.body2">No round 1 ingested.</MudText>
            }
            else
            {
                @RoundContent(_round1)
            }
        </MudTabPanel>

        <MudTabPanel Text="Round 2">
            @if (_round2 is null)
            {
                <MudText Typo="Typo.body2">No round 2 ingested.</MudText>
            }
            else
            {
                @RoundContent(_round2)
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Match? _match;
    private MatchRound? _round1;
    private MatchRound? _round2;

    private bool _round2WeaponStatsLookCumulative;

    private Dictionary<string, Dictionary<int, WeaponStatView>> _round1WeaponStatsByGuid = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var matchInfo = await db.Matches
            .AsNoTracking()
            .Where(m => m.Id == Id)
            .Select(m => new
            {
                m.Id,
                m.ExternalMatchId,
                m.MapName,
                m.Config,
                m.ServerName,
                m.ServerIp,
                m.ServerPort,
            })
            .FirstOrDefaultAsync();

        if (matchInfo is null)
        {
            _match = null;
            _round1 = null;
            _round2 = null;
            _round1WeaponStatsByGuid = new(StringComparer.OrdinalIgnoreCase);
            return;
        }

        var rounds = await db.MatchRounds
            .AsNoTracking()
            .AsSplitQuery()
            .Where(r => r.MatchId == matchInfo.Id && (r.RoundNumber == 1 || r.RoundNumber == 2))
            .Select(r => new MatchRound
            {
                Id = r.Id,
                MatchId = r.MatchId,
                Match = null!,
                RoundNumber = r.RoundNumber,
                DefenderTeam = r.DefenderTeam,
                WinnerTeam = r.WinnerTeam,
                TimeLimit = r.TimeLimit,
                NextTimeLimit = r.NextTimeLimit,
                RoundStartMs = r.RoundStartMs,
                RoundEndMs = r.RoundEndMs,
                RoundStartUnix = r.RoundStartUnix,
                RoundEndUnix = r.RoundEndUnix,
                IngestedAtUtc = r.IngestedAtUtc,
                RawJson = null,
                Sides = r.Sides.Select(s => new MatchSide
                {
                    Id = s.Id,
                    MatchRoundId = s.MatchRoundId,
                    MatchRound = null!,
                    Team = s.Team,
                    IsDefender = s.IsDefender,
                    IsWinner = s.IsWinner,
                    PlayerCount = s.PlayerCount,
                    TotalXp = s.TotalXp,
                    TotalDamageGiven = s.TotalDamageGiven,
                    TotalDamageReceived = s.TotalDamageReceived,
                    TotalTeamDamageGiven = s.TotalTeamDamageGiven,
                    TotalTeamDamageReceived = s.TotalTeamDamageReceived,
                    TotalGibs = s.TotalGibs,
                    TotalSelfKills = s.TotalSelfKills,
                    TotalTeamKills = s.TotalTeamKills,
                    TotalTeamGibs = s.TotalTeamGibs,
                    Players = s.Players.Select(p => new MatchPlayer
                    {
                        Id = p.Id,
                        MatchSideId = p.MatchSideId,
                        MatchSide = null!,
                        ClientNum = p.ClientNum,
                        Guid = p.Guid,
                        Name = p.Name,
                        Team = p.Team,
                        Rounds = p.Rounds,
                        Xp = p.Xp,
                        TimePlayedPercent = p.TimePlayedPercent,
                        DamageGiven = p.DamageGiven,
                        DamageReceived = p.DamageReceived,
                        TeamDamageGiven = p.TeamDamageGiven,
                        TeamDamageReceived = p.TeamDamageReceived,
                        Gibs = p.Gibs,
                        SelfKills = p.SelfKills,
                        TeamKills = p.TeamKills,
                        TeamGibs = p.TeamGibs,
                        WeaponStats = p.WeaponStats.Select(ws => new MatchPlayerWeaponStat
                        {
                            Id = ws.Id,
                            MatchPlayerId = ws.MatchPlayerId,
                            MatchPlayer = null!,
                            Weapon = ws.Weapon,
                            Hits = ws.Hits,
                            Atts = ws.Atts,
                            Kills = ws.Kills,
                            Deaths = ws.Deaths,
                            Headshots = ws.Headshots,
                        }).ToList(),
                    }).ToList(),
                }).ToList(),
                Obituaries = r.Obituaries.Select(o => new MatchObituary
                {
                    Id = o.Id,
                    MatchRoundId = o.MatchRoundId,
                    MatchRound = null!,
                    TimestampMs = o.TimestampMs,
                    TargetGuid = o.TargetGuid,
                    AttackerGuid = o.AttackerGuid,
                    MeansOfDeath = o.MeansOfDeath,
                    AttackerRespawnTime = o.AttackerRespawnTime,
                    VictimRespawnTime = o.VictimRespawnTime,
                }).ToList(),
            })
            .ToListAsync();

        _match = new Match
        {
            Id = matchInfo.Id,
            ExternalMatchId = matchInfo.ExternalMatchId,
            MapName = matchInfo.MapName,
            Config = matchInfo.Config,
            ServerName = matchInfo.ServerName,
            ServerIp = matchInfo.ServerIp,
            ServerPort = matchInfo.ServerPort,
            Rounds = rounds,
        };

        _round1 = rounds.FirstOrDefault(r => r.RoundNumber == 1);
        _round2 = rounds.FirstOrDefault(r => r.RoundNumber == 2);

        _round1WeaponStatsByGuid = BuildWeaponStatsByGuid(_round1);
        _round2WeaponStatsLookCumulative = LooksCumulativeWeaponStats(_round1WeaponStatsByGuid, _round2);
    }

    private static bool LooksCumulativeWeaponStats(
        IReadOnlyDictionary<string, Dictionary<int, WeaponStatView>> round1ByGuid,
        MatchRound? round2)
    {
        if (round2 is null || round1ByGuid.Count == 0)
        {
            return false;
        }

        var total = 0;
        var nonNeg = 0;
        var positive = 0;

        foreach (var p2 in round2.Sides.SelectMany(s => s.Players))
        {
            if (string.IsNullOrWhiteSpace(p2.Guid))
            {
                continue;
            }

            if (!round1ByGuid.TryGetValue(p2.Guid, out var r1Weapons))
            {
                continue;
            }

            foreach (var w2 in p2.WeaponStats)
            {
                if (!r1Weapons.TryGetValue(w2.Weapon, out var w1))
                {
                    continue;
                }

                total++;

                var hitsDiff = w2.Hits - w1.Hits;
                var attsDiff = w2.Atts - w1.Atts;
                var killsDiff = w2.Kills - w1.Kills;
                var deathsDiff = w2.Deaths - w1.Deaths;
                var hsDiff = w2.Headshots - w1.Headshots;

                if (hitsDiff >= 0 && attsDiff >= 0 && killsDiff >= 0 && deathsDiff >= 0 && hsDiff >= 0)
                {
                    nonNeg++;
                }

                if (hitsDiff > 0 || attsDiff > 0 || killsDiff > 0 || deathsDiff > 0 || hsDiff > 0)
                {
                    positive++;
                }
            }
        }

        if (total == 0)
        {
            return false;
        }

        return positive > 0 && (double)nonNeg / total >= 0.80;
    }

    private static double AccuracyPct(int hits, int atts) => atts <= 0 ? 0 : 100.0 * hits / atts;

