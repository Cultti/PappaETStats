    private static string WeaponName(int weaponId)
        => WeaponNames.TryGetValue(weaponId, out var name) ? name : weaponId.ToString();

    private static string ModName(int modId)
        => ModNames.TryGetValue(modId, out var name)
            ? BeautifyModName(name)
            : modId.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string BeautifyModName(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "-";
        }

        var s = raw;
        if (s.StartsWith("MOD_", StringComparison.OrdinalIgnoreCase))
        {
            s = s[4..];
        }

        return s.Replace('_', ' ');
    }

    private static string MatchResultText(Match match)
    {
        var round1 = match.Rounds.FirstOrDefault(r => r.RoundNumber == 1);
        var round2 = match.Rounds.FirstOrDefault(r => r.RoundNumber == 2);

        if (round2 is null)
        {
            return "Pending (no round 2 yet)";
        }

        if (round1 is null)
        {
            return OverallTeamName(MapToOverallTeam(2, round2.WinnerTeam));
        }

        // Stopwatch draw rule: if round 2 next time equals the ORIGINAL first-round time limit,
        // neither side set a time.
        var baseLimit = ParseStopwatchTimeSeconds(round1.TimeLimit);
        var t2Next = ParseStopwatchTimeSeconds(round2.NextTimeLimit);
        if (baseLimit is not null && t2Next is not null)
        {
            if (t2Next.Value == baseLimit.Value)
            {
                return "Draw";
            }
        }
        else if (string.Equals(Norm(round2.NextTimeLimit), Norm(round1.TimeLimit), StringComparison.Ordinal))
        {
            return "Draw";
        }

        var t1 = ParseStopwatchTimeSeconds(round1.NextTimeLimit);
        var t2 = t2Next;

        if (t1 is null || t2 is null)
        {
            return OverallTeamName(MapToOverallTeam(2, round2.WinnerTeam));
        }

        // Smaller time is better (faster). If round 2 beats the time, round 2 winner wins.
        // If round 2 matches or is slower, round 1 winner wins.
        if (t2.Value < t1.Value)
        {
            return OverallTeamName(MapToOverallTeam(2, round2.WinnerTeam));
        }

        return OverallTeamName(MapToOverallTeam(1, round1.WinnerTeam));
    }

    private static string RoundTeamName(int teamId) => teamId switch
    {
        1 => "Axis",
        2 => "Allies",
        3 => "Spectators",
        _ => $"Team {teamId}",
    };

    private static string OverallTeamName(int teamId) => teamId switch
    {
        1 => "Team 1",
        2 => "Team 2",
        _ => $"Team {teamId}",
    };

    private static int MapToOverallTeam(int roundNumber, int teamId)
    {
        // In stopwatch, teams swap between rounds.
        // Overall Team 1/2 are defined by round 1.
        if (roundNumber == 2)
        {
            return teamId switch
            {
                1 => 2,
                2 => 1,
                _ => teamId,
            };
        }

        return teamId;
    }

    private static string Norm(string? s) => (s ?? string.Empty).Trim();

    private static int? ParseStopwatchTimeSeconds(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var v = value.Trim();
        var dot = v.IndexOf('.');
        if (dot >= 0)
        {
            v = v[..dot];
        }

        var parts = v.Split(':');
        if (parts.Length is < 1 or > 3)
        {
            return null;
        }

        static bool TryParsePart(string s, out int n)
            => int.TryParse(s.Trim(), out n) && n >= 0;

        if (parts.Length == 1)
        {
            return TryParsePart(parts[0], out var seconds) ? seconds : null;
        }

        if (parts.Length == 2)
        {
            if (!TryParsePart(parts[0], out var minutes) || !TryParsePart(parts[1], out var seconds))
            {
                return null;
            }

            return checked(minutes * 60 + seconds);
        }

        if (!TryParsePart(parts[0], out var hours) || !TryParsePart(parts[1], out var minutes2) || !TryParsePart(parts[2], out var seconds2))
        {
            return null;
        }

        return checked(hours * 3600 + minutes2 * 60 + seconds2);
    }

    private RenderFragment RoundContent(MatchRound round) => @<div>
        @foreach (var side in round.Sides.OrderBy(s => s.Team))
        {
            @SidePanel(
                teamLabel: RoundTeamName(side.Team),
                showWinner: side.IsWinner,
                playerCount: side.PlayerCount,
                players: side.Players,
                weaponStatsForPlayer: (p) => WeaponStatsForPlayer(round, p, subtractRound1: round.RoundNumber == 2 && _round2WeaponStatsLookCumulative))
        }

        @ObituariesPanel(round)
    </div>;

    private RenderFragment ObituariesPanel(MatchRound round) => @<MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6">Obituaries</MudText>

        @if (round.Obituaries is null || round.Obituaries.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-1">No obituaries recorded.</MudText>
        }
        else
        {
            var guidToName = round.Sides
                .SelectMany(s => s.Players)
                .Where(p => !string.IsNullOrWhiteSpace(p.Guid))
                .GroupBy(p => p.Guid, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().Name, StringComparer.OrdinalIgnoreCase);

            <MudTable Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Items="round.Obituaries.OrderBy(o => o.TimestampMs)">
                <ColGroup>
                    <col style="width:90px;" />
                    <col />
                    <col />
                    <col style="width:90px;" />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Attacker</MudTh>
                    <MudTh>Victim</MudTh>
                    <MudTh align="Align.Right">MOD</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Time">@FormatObituaryTime(round, context.TimestampMs)</MudTd>
                    <MudTd DataLabel="Attacker">@PlayerNameOrGuid(guidToName, context.AttackerGuid)</MudTd>
                    <MudTd DataLabel="Victim">@PlayerNameOrGuid(guidToName, context.TargetGuid)</MudTd>
                    <MudTd DataLabel="MOD" align="Align.Right">@ModName(context.MeansOfDeath)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>;

    private RenderFragment PlayerNameOrGuid(IReadOnlyDictionary<string, string> guidToName, string? guid) => @<span>
        @if (string.IsNullOrWhiteSpace(guid))
        {
            @("-")
        }
        else if (guidToName.TryGetValue(guid, out var name))
        {
            <EtColoredText Text="@name" />
        }
        else
        {
            @(guid)
        }
    </span>;

    private static string FormatObituaryTime(MatchRound round, long timestampMs)
    {
        // Some sources store absolute timestamps; some store relative-to-round.
        // Prefer a relative time if we can infer it.
        var relativeMs = (round.RoundStartMs > 0 && timestampMs > round.RoundStartMs)
            ? timestampMs - round.RoundStartMs
            : timestampMs;

        if (relativeMs < 0)
        {
            relativeMs = timestampMs;
        }

        var t = TimeSpan.FromMilliseconds(relativeMs);
        return t.ToString(@"mm\:ss\.fff", System.Globalization.CultureInfo.InvariantCulture);
    }

    private RenderFragment OverallContent(Match match, MatchRound round2) => @<div>
        @{
            var winnerOverallTeamId = OverallWinnerTeamId(match);
            var round1 = match.Rounds.FirstOrDefault(r => r.RoundNumber == 1);
        }
        @foreach (var side in BuildOverallSidesFromRounds(round1, round2))
        {
            @SidePanel(
                teamLabel: side.TeamLabel,
                showWinner: winnerOverallTeamId is not null && winnerOverallTeamId.Value == side.OverallTeamId,
                playerCount: side.PlayerCount,
                players: side.Players,
                weaponStatsForPlayer: (p) => WeaponStatsForPlayer(round2, p, subtractRound1: false))
        }
    </div>;

    private RenderFragment SidePanel(
        string teamLabel,
        bool showWinner,
        int playerCount,
        IReadOnlyList<MatchPlayer> players,
        Func<MatchPlayer, IEnumerable<WeaponStatView>> weaponStatsForPlayer) => @<MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.h6">@teamLabel</MudText>
            @if (showWinner)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">Winner</MudChip>
            }
        </MudStack>

        <MudText Typo="Typo.body2" Class="mt-1">
            Players: @playerCount
        </MudText>

        @PlayersGrid(players, weaponStatsForPlayer)

        @{
            var totals = ComputeSideTotals(players, weaponStatsForPlayer);
            var totalDamageGiven = players.Sum(p => p.DamageGiven);
            var totalDamageReceived = players.Sum(p => p.DamageReceived);
        }

        <MudDivider Class="my-3" />

        <MudSimpleTable Dense="true" Style="width:100%">
            <colgroup>
                <col style="width:28px;" />
                <col />
                <col style="width:6ch;" />
                <col style="width:3ch;" />
                <col style="width:3ch;" />
                <col style="width:6ch;" />
                <col style="width:6ch;" />
                <col style="width:3ch;" />
                <col style="width:3ch;" />
                <col style="width:3ch;" />
                <col style="width:3ch;" />
            </colgroup>
            <thead>
                <tr>
                    <th></th>
                    <th>Totals</th>
                    <th style="text-align:right;">K/D</th>
                    <th style="text-align:right;">Kills</th>
                    <th style="text-align:right;">Deaths</th>
                    <th style="text-align:right;">Dmg G</th>
                    <th style="text-align:right;">Dmg R</th>
                    <th style="text-align:right;">HS</th>
                    <th style="text-align:right;">Gibs</th>
                    <th style="text-align:right;">SK</th>
                    <th style="text-align:right;">Rev</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td></td>
                    <td><strong>Totals</strong></td>
                    <td style="text-align:right;"><strong>@totals.Kdr.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</strong></td>
                    <td style="text-align:right;"><strong>@totals.Kills</strong></td>
                    <td style="text-align:right;"><strong>@totals.Deaths</strong></td>
                    <td style="text-align:right;"><strong>@totalDamageGiven</strong></td>
                    <td style="text-align:right;"><strong>@totalDamageReceived</strong></td>
                    <td style="text-align:right;"><strong>@totals.Headshots</strong></td>
                    <td style="text-align:right;"><strong>@totals.Gibs</strong></td>
                    <td style="text-align:right;"><strong>@totals.SelfKills</strong></td>
                    <td style="text-align:right;"><strong>@totals.Revives</strong></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>;

    private RenderFragment PlayersGrid(
        IReadOnlyList<MatchPlayer> players,
        Func<MatchPlayer, IEnumerable<WeaponStatView>> weaponStatsForPlayer) => @<MudDataGrid T="MatchPlayer"
            Items="players.OrderByDescending(p => p.DamageGiven)"
            Dense="true"
            Hover="true"
            ReadOnly="true"
            SortMode="MudBlazor.SortMode.None"
            expand-single-row="true"
            Class="pappa-players-grid">
        <Columns>
            <HierarchyColumn T="MatchPlayer" enable-header-toggle="true" />

            <TemplateColumn T="MatchPlayer" Title="Player" HeaderClass="pappa-col-player" CellClass="pappa-col-player">
                <CellTemplate>
                    <span class="pappa-player-cell">
                        @if (!string.IsNullOrWhiteSpace(context.Item.Guid))
                        {
                            <MudLink Href="@($"/player/{System.Uri.EscapeDataString(context.Item.Guid)}")" Underline="Underline.Always">
                                <EtColoredText Text="@context.Item.Name" />
                            </MudLink>
                        }
                        else
                        {
                            <EtColoredText Text="@context.Item.Name" />
                        }
                    </span>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MatchPlayer" Title="K/D" HeaderClass="pappa-col-num pappa-col-kdr" CellClass="pappa-col-num pappa-col-kdr">
                <CellTemplate>
                    @{
                        var ws = weaponStatsForPlayer(context.Item).ToList();
                        var kills = ws.Sum(s => s.Kills);
                        var deaths = ws.Sum(s => s.Deaths);
                        var kdr = deaths <= 0 ? kills : (double)kills / deaths;
                    }
                    @kdr.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MatchPlayer" Title="Kills" HeaderClass="pappa-col-num pappa-col-2" CellClass="pappa-col-num pappa-col-2">
                <CellTemplate>
                    @{
                        var kills = weaponStatsForPlayer(context.Item).Sum(s => s.Kills);
                    }
                    @kills
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MatchPlayer" Title="Deaths" HeaderClass="pappa-col-num pappa-col-2" CellClass="pappa-col-num pappa-col-2">
                <CellTemplate>
                    @{
                        var deaths = weaponStatsForPlayer(context.Item).Sum(s => s.Deaths);
                    }
                    @deaths
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn T="MatchPlayer" TProperty="int" Property="x => x.DamageGiven" Title="Dmg G" HeaderClass="pappa-col-num pappa-col-5" CellClass="pappa-col-num pappa-col-5" />
            <PropertyColumn T="MatchPlayer" TProperty="int" Property="x => x.DamageReceived" Title="Dmg R" HeaderClass="pappa-col-num pappa-col-5" CellClass="pappa-col-num pappa-col-5" />

            <TemplateColumn T="MatchPlayer" Title="HS" HeaderClass="pappa-col-num pappa-col-2" CellClass="pappa-col-num pappa-col-2">
                <CellTemplate>
                    @{
                        var hs = weaponStatsForPlayer(context.Item).Sum(s => s.Headshots);
                    }
                    @hs
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn T="MatchPlayer" TProperty="int" Property="x => x.Gibs" Title="Gibs" HeaderClass="pappa-col-num pappa-col-2" CellClass="pappa-col-num pappa-col-2" />
            <PropertyColumn T="MatchPlayer" TProperty="int" Property="x => x.SelfKills" Title="SK" HeaderClass="pappa-col-num pappa-col-2" CellClass="pappa-col-num pappa-col-2" />

            <TemplateColumn T="MatchPlayer" Title="Rev" HeaderClass="pappa-col-num pappa-col-2" CellClass="pappa-col-num pappa-col-2">
                <CellTemplate>
                    @{
                        var rev = weaponStatsForPlayer(context.Item).Where(s => s.Weapon == 27).Sum(s => s.Hits);
                    }
                    @rev
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <ChildRowContent>
            @{
                var weaponStats = weaponStatsForPlayer(context.Item)
                    .OrderBy(ws => ws.Weapon)
                    .ToList();
            }

            <MudCard Elevation="0" Class="mt-2" Style="border:1px solid var(--mud-palette-lines-default)">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">Weapon stats for <strong><EtColoredText Text="@context.Item.Name" /></strong></MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudStack Spacing="0" Class="pa-4">
                        <MudText Typo="Typo.body2"><strong>Team kills:</strong> @context.Item.TeamKills</MudText>
                        <MudText Typo="Typo.body2"><strong>Team dmg given:</strong> @context.Item.TeamDamageGiven</MudText>
                        <MudText Typo="Typo.body2"><strong>Team dmg received:</strong> @context.Item.TeamDamageReceived</MudText>
                    </MudStack>

                    @if (weaponStats.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-4 pt-0">No weapon stats recorded.</MudText>
                    }
                    else
                    {
                        <MudTable Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Items="weaponStats" Context="ws" Elevation="0">
                            <ColGroup>
                                <col />
                                <col style="width:120px;" />
                                <col style="width:90px;" />
                                <col style="width:90px;" />
                                <col style="width:90px;" />
                                <col style="width:90px;" />
                            </ColGroup>
                            <HeaderContent>
                                <MudTh>Weapon</MudTh>
                                <MudTh align="Align.Right">Acc</MudTh>
                                <MudTh align="Align.Right">Hits/Atts</MudTh>
                                <MudTh align="Align.Right">Kills</MudTh>
                                <MudTh align="Align.Right">Deaths</MudTh>
                                <MudTh align="Align.Right">HS</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Weapon">@WeaponName(ws.Weapon)</MudTd>
                                <MudTd DataLabel="Acc" align="Align.Right">@(ws.Atts <= 0 ? string.Empty : $"{AccuracyPct(ws.Hits, ws.Atts):0.0}%")</MudTd>
                                <MudTd DataLabel="Hits/Atts" align="Align.Right">@(ws.Atts <= 0 ? string.Empty : $"{ws.Hits}/{ws.Atts}")</MudTd>
                                <MudTd DataLabel="Kills" align="Align.Right">@(ws.Weapon == 27 ? string.Empty : ws.Kills)</MudTd>
                                <MudTd DataLabel="Deaths" align="Align.Right">@(ws.Weapon == 27 ? string.Empty : ws.Deaths)</MudTd>
                                <MudTd DataLabel="HS" align="Align.Right">@(ws.Weapon == 27 ? string.Empty : ws.Headshots)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudCardContent>
            </MudCard>
        </ChildRowContent>
    </MudDataGrid>;

    private sealed record WeaponStatView(int Weapon, int Hits, int Atts, int Kills, int Deaths, int Headshots);

    private sealed class OverallSideView
    {
        public required int OverallTeamId { get; init; }
        public required string TeamLabel { get; init; }
        public required int PlayerCount { get; init; }
        public required IReadOnlyList<MatchPlayer> Players { get; init; }
    }

    private sealed class OverallPlayerAccumulator
    {
        public required string Key { get; init; }
        public Guid Id { get; set; }
        public string Guid { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;

        public int DamageGiven { get; set; }
        public int DamageReceived { get; set; }
        public int TeamDamageGiven { get; set; }
        public int TeamDamageReceived { get; set; }
        public int Gibs { get; set; }
        public int SelfKills { get; set; }
        public int TeamKills { get; set; }
        public int TeamGibs { get; set; }

        public Dictionary<int, MatchPlayerWeaponStat> WeaponStatsByWeapon { get; } = new();
    }

    private static IReadOnlyList<OverallSideView> BuildOverallSidesFromRounds(MatchRound? round1, MatchRound round2)
    {
        var byOverallTeam = new Dictionary<int, Dictionary<string, OverallPlayerAccumulator>>
        {
            [1] = new Dictionary<string, OverallPlayerAccumulator>(StringComparer.OrdinalIgnoreCase),
            [2] = new Dictionary<string, OverallPlayerAccumulator>(StringComparer.OrdinalIgnoreCase),
        };

        static string PlayerKey(MatchPlayer p)
            => !string.IsNullOrWhiteSpace(p.Guid) ? p.Guid : p.Id.ToString("D", System.Globalization.CultureInfo.InvariantCulture);

        static void MergeInto(
            Dictionary<int, Dictionary<string, OverallPlayerAccumulator>> byTeam,
            MatchRound round,
            Func<int, int> mapToOverallTeam,
            bool preferIdsAndNames)
        {
            foreach (var p in round.Sides.SelectMany(s => s.Players))
            {
                var overallTeam = mapToOverallTeam(p.Team);
                if (overallTeam is not (1 or 2))
                {
                    continue;
                }

                var key = PlayerKey(p);
                if (!byTeam[overallTeam].TryGetValue(key, out var acc))
                {
                    acc = new OverallPlayerAccumulator
                    {
                        Key = key,
                        Id = p.Id,
                        Guid = p.Guid,
                        Name = p.Name,
                    };
                    byTeam[overallTeam][key] = acc;
                }

                if (preferIdsAndNames)
                {
                    acc.Id = p.Id;
                    if (!string.IsNullOrWhiteSpace(p.Guid))
                    {
                        acc.Guid = p.Guid;
                    }

                    if (!string.IsNullOrWhiteSpace(p.Name))
                    {
                        acc.Name = p.Name;
                    }
                }

                acc.DamageGiven += p.DamageGiven;
                acc.DamageReceived += p.DamageReceived;
                acc.TeamDamageGiven += p.TeamDamageGiven;
                acc.TeamDamageReceived += p.TeamDamageReceived;
                acc.Gibs += p.Gibs;
                acc.SelfKills += p.SelfKills;
                acc.TeamKills += p.TeamKills;
                acc.TeamGibs += p.TeamGibs;

                foreach (var ws in p.WeaponStats)
                {
                    if (!acc.WeaponStatsByWeapon.TryGetValue(ws.Weapon, out var existing))
                    {
                        acc.WeaponStatsByWeapon[ws.Weapon] = new MatchPlayerWeaponStat
                        {
                            Id = ws.Id,
                            MatchPlayerId = acc.Id,
                            MatchPlayer = null!,
                            Weapon = ws.Weapon,
                            Hits = ws.Hits,
                            Atts = ws.Atts,
                            Kills = ws.Kills,
                            Deaths = ws.Deaths,
                            Headshots = ws.Headshots,
                        };
                        continue;
                    }

                    existing.Hits += ws.Hits;
                    existing.Atts += ws.Atts;
                    existing.Kills += ws.Kills;
                    existing.Deaths += ws.Deaths;
                    existing.Headshots += ws.Headshots;
                }
            }
        }

        if (round1 is not null)
        {
            MergeInto(byOverallTeam, round1, teamId => MapToOverallTeam(1, teamId), preferIdsAndNames: false);
        }
        MergeInto(byOverallTeam, round2, teamId => MapToOverallTeam(2, teamId), preferIdsAndNames: true);

        MatchPlayer ToPlayer(OverallPlayerAccumulator acc)
        {
            var weaponStats = acc.WeaponStatsByWeapon.Values
                .Select(ws =>
                {
                    ws.MatchPlayerId = acc.Id;
                    return ws;
                })
                .OrderBy(ws => ws.Weapon)
                .ToList();

            return new MatchPlayer
            {
                Id = acc.Id,
                MatchSideId = Guid.Empty,
                MatchSide = null!,
                ClientNum = 0,
                Guid = string.IsNullOrWhiteSpace(acc.Guid) ? string.Empty : acc.Guid,
                Name = string.IsNullOrWhiteSpace(acc.Name) ? acc.Key : acc.Name,
                Team = 0,
                Rounds = 0,
                Xp = 0,
                TimePlayedPercent = 0,
                DamageGiven = acc.DamageGiven,
                DamageReceived = acc.DamageReceived,
                TeamDamageGiven = acc.TeamDamageGiven,
                TeamDamageReceived = acc.TeamDamageReceived,
                Gibs = acc.Gibs,
                SelfKills = acc.SelfKills,
                TeamKills = acc.TeamKills,
                TeamGibs = acc.TeamGibs,
                WeaponStats = weaponStats,
            };
        }

        return byOverallTeam
            .Select(kv => new OverallSideView
            {
                OverallTeamId = kv.Key,
                TeamLabel = OverallTeamName(kv.Key),
                PlayerCount = kv.Value.Count,
                Players = kv.Value.Values.Select(ToPlayer).ToList(),
            })
            .OrderBy(s => s.OverallTeamId)
            .ToList();
    }

    private sealed record SideTotals(int Kills, int Deaths, double Kdr, int Headshots, int Gibs, int SelfKills, int Revives);

    private static SideTotals ComputeSideTotals(
        IReadOnlyList<MatchPlayer> players,
        Func<MatchPlayer, IEnumerable<WeaponStatView>> weaponStatsForPlayer)
    {
        var totalKills = 0;
        var totalDeaths = 0;
        var totalHeadshots = 0;
        var totalRevives = 0;

        foreach (var player in players)
        {
            foreach (var ws in weaponStatsForPlayer(player))
            {
                totalKills += ws.Kills;
                totalDeaths += ws.Deaths;
                totalHeadshots += ws.Headshots;
                if (ws.Weapon == 27)
                {
                    totalRevives += ws.Hits;
                }
            }
        }

        var totalGibs = players.Sum(p => p.Gibs);
        var totalSelfKills = players.Sum(p => p.SelfKills);

        var kdr = totalDeaths <= 0 ? totalKills : (double)totalKills / totalDeaths;
        return new SideTotals(totalKills, totalDeaths, kdr, totalHeadshots, totalGibs, totalSelfKills, totalRevives);
    }

    private Dictionary<string, Dictionary<int, WeaponStatView>> BuildWeaponStatsByGuid(MatchRound? round)
    {
        var dict = new Dictionary<string, Dictionary<int, WeaponStatView>>(StringComparer.OrdinalIgnoreCase);
        if (round is null)
        {
            return dict;
        }

        foreach (var p in round.Sides.SelectMany(s => s.Players))
        {
            if (string.IsNullOrWhiteSpace(p.Guid))
            {
                continue;
            }

            if (!dict.TryGetValue(p.Guid, out var byWeapon))
            {
                byWeapon = new Dictionary<int, WeaponStatView>();
                dict[p.Guid] = byWeapon;
            }

            foreach (var ws in p.WeaponStats)
            {
                if (!byWeapon.TryGetValue(ws.Weapon, out var existing))
                {
                    existing = new WeaponStatView(ws.Weapon, 0, 0, 0, 0, 0);
                }

                byWeapon[ws.Weapon] = existing with
                {
                    Hits = existing.Hits + ws.Hits,
                    Atts = existing.Atts + ws.Atts,
                    Kills = existing.Kills + ws.Kills,
                    Deaths = existing.Deaths + ws.Deaths,
                    Headshots = existing.Headshots + ws.Headshots,
                };
            }
        }

        return dict;
    }

    private IEnumerable<WeaponStatView> WeaponStatsForPlayer(MatchRound round, MatchPlayer player, bool subtractRound1)
    {
        var baseStats = player.WeaponStats
            .GroupBy(ws => ws.Weapon)
            .ToDictionary(
                g => g.Key,
                g => new WeaponStatView(
                    g.Key,
                    g.Sum(x => x.Hits),
                    g.Sum(x => x.Atts),
                    g.Sum(x => x.Kills),
                    g.Sum(x => x.Deaths),
                    g.Sum(x => x.Headshots)));

        if (!subtractRound1 || round.RoundNumber != 2 || string.IsNullOrWhiteSpace(player.Guid))
        {
            return baseStats.Values;
        }

        if (!_round1WeaponStatsByGuid.TryGetValue(player.Guid, out var round1ByWeapon))
        {
            return baseStats.Values;
        }

        var result = new List<WeaponStatView>(baseStats.Count);
        foreach (var kv in baseStats)
        {
            var w = kv.Key;
            var s2 = kv.Value;
            if (!round1ByWeapon.TryGetValue(w, out var s1))
            {
                result.Add(s2);
                continue;
            }

            result.Add(new WeaponStatView(
                w,
                Math.Max(0, s2.Hits - s1.Hits),
                Math.Max(0, s2.Atts - s1.Atts),
                Math.Max(0, s2.Kills - s1.Kills),
                Math.Max(0, s2.Deaths - s1.Deaths),
                Math.Max(0, s2.Headshots - s1.Headshots)));
        }

        return result.Where(ws => ws.Atts != 0 || ws.Hits != 0 || ws.Kills != 0 || ws.Deaths != 0 || ws.Headshots != 0);
    }

    private static int? OverallWinnerTeamId(Match match)
    {
        var round1 = match.Rounds.FirstOrDefault(r => r.RoundNumber == 1);
        var round2 = match.Rounds.FirstOrDefault(r => r.RoundNumber == 2);

        if (round2 is null)
        {
            return null;
        }

        if (round1 is null)
        {
            return MapToOverallTeam(2, round2.WinnerTeam);
        }

        // Stopwatch draw rule: if round 2 next time equals the ORIGINAL first-round time limit,
        // neither side set a time.
        var baseLimit = ParseStopwatchTimeSeconds(round1.TimeLimit);
        var t2Next = ParseStopwatchTimeSeconds(round2.NextTimeLimit);
        if (baseLimit is not null && t2Next is not null)
        {
            if (t2Next.Value == baseLimit.Value)
            {
                return null;
            }
        }
        else if (string.Equals(Norm(round2.NextTimeLimit), Norm(round1.TimeLimit), StringComparison.Ordinal))
        {
            return null;
        }

        var t1 = ParseStopwatchTimeSeconds(round1.NextTimeLimit);
        var t2 = t2Next;

        if (t1 is null || t2 is null)
        {
            return MapToOverallTeam(2, round2.WinnerTeam);
        }

        // Smaller time is better (faster). If round 2 beats the time, round 2 winner wins.
        // If round 2 matches or is slower, round 1 winner wins.
        if (t2.Value < t1.Value)
        {
            return MapToOverallTeam(2, round2.WinnerTeam);
        }

        return MapToOverallTeam(1, round1.WinnerTeam);
    }
}
