@page "/matches/combined"
@using Microsoft.EntityFrameworkCore
@using PappaETStats.Server.Data
@using PappaETStats.Server.Components.Shared
@inject IDbContextFactory<StatsDbContext> DbFactory

<PageTitle>Combined Results</PageTitle>
<MudText Typo="Typo.h4">Combined Results</MudText>

@if (_loading)
{
    <MudText>Loading…</MudText>
}
else if (_mapIds.Count == 0)
{
    <MudText>Select one or more maps on the matches page first.</MudText>
}
else
{
    <MatchStatisticsView MapIds="_mapIds" Title="Combined statistics" />
    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Selected maps (@_maps.Count)</MudText>
        <MatchListTable Items="_maps"
                        GetMatchId="@(m => m.Id)"
                        GetRound1StartUnix="@(m => m.Start)"
                        GetMapName="@(m => m.MapName)"
                        GetServerName="@(m => m.ServerName)"
                        GetTeam1PlayerCount="@(m => m.Team1Count)"
                        GetTeam2PlayerCount="@(m => m.Team2Count)"
                        GetTimeText="@(m => m.TimeText)"
                        ShowPager="false" Dense="true" />
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery(Name = "id")] public string[]? Id { get; set; }
    private bool _loading = true;
    private List<Guid> _mapIds = [];
    private List<MapRow> _maps = [];
    private sealed record MapRow(Guid Id, long? Start, string MapName, string ServerName,
        int? Team1Count, int? Team2Count, string TimeText);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var requested = (Id ?? []).Select(value => Guid.TryParse(value, out var parsed) ? parsed : Guid.Empty)
            .Where(id => id != Guid.Empty).Distinct().ToList();
        await using var db = await DbFactory.CreateDbContextAsync();
        var maps = await db.Matches.AsNoTracking().AsSplitQuery().Include(m => m.Rounds).ThenInclude(r => r.Sides)
            .Where(m => requested.Contains(m.Id)).ToListAsync();
        _mapIds = maps.Select(m => m.Id).ToList();
        _maps = maps.Select(m =>
        {
            var first = m.Rounds.FirstOrDefault(r => r.RoundNumber == 1);
            var second = m.Rounds.FirstOrDefault(r => r.RoundNumber == 2);
            var sides = first?.Sides ?? second?.Sides;
            return new MapRow(m.Id, first?.RoundStartUnix ?? second?.RoundStartUnix, m.MapName, m.ServerName,
                sides?.FirstOrDefault(s => s.Team == 1)?.PlayerCount, sides?.FirstOrDefault(s => s.Team == 2)?.PlayerCount,
                $"{first?.NextTimeLimit ?? "—"} / {second?.NextTimeLimit ?? "—"}");
        }).OrderByDescending(m => m.Start).ToList();
        _loading = false;
    }
}
